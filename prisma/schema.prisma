// Content OS — Prisma Schema
// Data Domains: Identity, Projects, Topics, Research, Content, Analysis, Insights, Angles, Strategy, Drafts, Evaluation, Humanization, StrategyEvaluation, Agents, Skills, Runs

generator client {
  provider = "prisma-client-js"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "sqlite"
}

// ─── Identity ───────────────────────────────────────────

model User {
  id        String   @id @default(cuid())
  email     String   @unique
  name      String?
  avatar    String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  projects            Project[]
  inspirations        Inspiration[]
  contentArchives     UserContentArchive[]
  writingProfile      UserWritingProfile?
  personas            Persona[]
}

// ─── Projects ───────────────────────────────────────────

model Project {
  id          String   @id @default(cuid())
  name        String
  description String?
  status      String   @default("active") // active | archived
  userId      String
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  user   User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  topics Topic[]
}

// ─── Persona ───────────────────────────────────────────
model Persona {
  id          String   @id @default(cuid())
  userId      String
  name        String
  description String?
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  user   User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  topics Topic[]

  @@index([userId])
}

// ─── Topics ─────────────────────────────────────────────

model Topic {
  id          String   @id @default(cuid())
  projectId   String
  topic       String
  category    String?
  platform    String? // xiaohongshu | douyin | weibo | zhihu | wechat
  audience    String?
  contentType String? // emotional | opinion | story | knowledge
  goal        String?
  tone        String?
  constraints String?
  status      String   @default("DRAFT")
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  project              Project              @relation(fields: [projectId], references: [id], onDelete: Cascade)
  researchSessions     ResearchSession[]
  contents             Content[]
  analyses             ContentAnalysis[]
  insights             AudienceInsight[]
  angles               Angle[]
  strategy             ContentStrategy?
  drafts               Draft[]
  evaluations          Evaluation[]
  humanizations       Humanization[]
  strategyEvaluations  StrategyEvaluation[]
  contentAdaptations   ContentAdaptation[]
  persona              Persona?  @relation(fields: [personaId], references: [id], onDelete: SetNull)
  personaId            String?
  activeDraftId        String?   @unique
  activeDraft          Draft?    @relation("TopicActiveDraft", fields: [activeDraftId], references: [id], onDelete: SetNull)

  @@index([projectId])
  @@index([personaId])
  @@index([activeDraftId])
}

// ─── Research ────────────────────────────────────────────

model ResearchSession {
  id          String   @id @default(cuid())
  topicId     String
  status      String   @default("pending")
  queries     Json?
  result      Json?
  startedAt   DateTime?
  completedAt DateTime?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  topic    Topic     @relation(fields: [topicId], references: [id], onDelete: Cascade)
  contents Content[]

  @@index([topicId])
}

// ─── Content ────────────────────────────────────────────

model Content {
  id                String   @id @default(cuid())
  researchSessionId String?
  topicId           String
  platform          String?
  url               String?
  title             String?
  author            String?
  body              String?
  publishedAt       DateTime?
  likes             Int?
  commentsCount     Int?
  shares            Int?
  favorites         Int?
  views             Int?
  engagementRate    Float?
  keywords          Json?
  emotions          Json?
  contentStructure  Json?
  rawHtml           String?
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  researchSession ResearchSession? @relation(fields: [researchSessionId], references: [id], onDelete: SetNull)
  topic           Topic            @relation(fields: [topicId], references: [id], onDelete: Cascade)
  analysis        ContentAnalysis?
  comments        Comment[]

  @@index([topicId])
  @@index([platform])
}

// ─── Content Library ───────────────────────────────────────

model ContentLibraryItem {
  id              String   @id @default(cuid())
  userId          String  @default("default")
  platform        String  @default("web")
  url             String
  title           String?
  content         String?
  author          String?
  cover           String?
  publishedAt     String?
  likes           Int?
  commentsCount   Int?
  shares          Int?
  favorites       Int?
  views           Int?
  transcript      Json?
  collectedComments Json?
  commentAnalysis Json?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  @@index([userId])
  @@index([platform])
}

model Comment {
  id        String   @id @default(cuid())
  contentId String
  author    String?
  text      String
  likes     Int?
  createdAt DateTime @default(now())

  content Content @relation(fields: [contentId], references: [id], onDelete: Cascade)

  @@index([contentId])
}

// ─── Analysis ────────────────────────────────────────────

model ContentAnalysis {
  id               String   @id @default(cuid())
  contentId        String   @unique
  topicId          String
  hookScore        Int?
  emotionScore     Int?
  relatabilityScore Int?
  noveltyScore     Int?
  structureScore   Int?
  shareabilityScore Int?
  conflictScore    Int?
  storyScore       Int?
  viralScore       Int?
  controversyScore Int?
  utilityScore     Int?
  reasoning        String?
  contentStructure Json?
  emotionCurve     Json?
  strengths       Json?
  weaknesses       Json?
  keyFactors       Json?
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  content Content @relation(fields: [contentId], references: [id], onDelete: Cascade)
  topic   Topic   @relation(fields: [topicId], references: [id], onDelete: Cascade)

  @@index([topicId])
}

// ─── Insights ────────────────────────────────────────────

model AudienceInsight {
  id             String   @id @default(cuid())
  topicId        String
  painPoints     Json?
  emotions       Json?
  questions      Json?
  opinions       Json?
  controversies  Json?
  stories        Json?
  desires        Json?
  fears          Json?
  needs          Json?
  behaviors      Json?
  preferences    Json?
  contentGaps   Json?
  demographics   Json?
  emotionDetails Json?
  summary        String?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  topic Topic @relation(fields: [topicId], references: [id], onDelete: Cascade)

  @@index([topicId])
}

// ─── Angles ─────────────────────────────────────────────

model Angle {
  id                 String   @id @default(cuid())
  topicId            String
  title              String
  coreThesis         String
  targetAudience     String?
  emotion            String?
  noveltyScore       Int?
  relatabilityScore  Int?
  shareabilityScore  Int?
  risk               String?
  supportingEvidence String?
  keyPoints          Json?
  audienceAppeal     String?
  estimatedViralScore Int?
  status             String   @default("GENERATED")
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt

  topic Topic @relation(fields: [topicId], references: [id], onDelete: Cascade)

  @@index([topicId])
}

// ─── Strategy ───────────────────────────────────────────

model ContentStrategy {
  id               String   @id @default(cuid())
  topicId          String   @unique
  angleId          String?
  coreThesis       String
  targetEmotion    String?
  targetAudience   String?
  hookStrategy     String?
  contentStructure Json?
  storyStrategy    String?
  conflict         String?
  turningPoint     String?
  endingStrategy   String?
  ctaStrategy      String?
  keyArguments     Json?
  suggestedReferences Json?
  tone             String?
  estimatedWordCount Int?
  approvalStatus   String   @default("pending")
  rejectionReason  String?
  approvedAt       DateTime?
  rejectedAt       DateTime?
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  topic Topic @relation(fields: [topicId], references: [id], onDelete: Cascade)

  @@index([topicId])
  @@index([approvalStatus])
}

// ─── Drafts ─────────────────────────────────────────────

model Draft {
  id            String   @id @default(cuid())
  topicId       String
  version       Int      @default(1)
  parentDraftId String?
  changeType    String   @default("INITIAL")
  changeReason  String?
  title         String?
  content       String
  outline       Json?
  status        String   @default("DRAFT")
  wordCount     Int?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  topic               Topic                @relation(fields: [topicId], references: [id], onDelete: Cascade)
  activeTopic         Topic?               @relation("TopicActiveDraft")
  parentDraft         Draft?               @relation("DraftLineage", fields: [parentDraftId], references: [id], onDelete: SetNull)
  childDrafts         Draft[]              @relation("DraftLineage")
  evaluation          Evaluation?
  humanization        Humanization?
  strategyEvaluation  StrategyEvaluation?

  @@index([topicId])
  @@index([parentDraftId])
  @@unique([topicId, version])
}

// ─── Evaluation ─────────────────────────────────────────

model Evaluation {
  id                String   @id @default(cuid())
  draftId           String   @unique
  topicId           String
  hookScore         Int?
  emotionScore      Int?
  relatabilityScore Int?
  noveltyScore      Int?
  structureScore    Int?
  readabilityScore   Int?
  shareabilityScore Int?
  platformFitScore   Int?
  aiStyleScore      Int?
  utilityScore       Int?
  emotionalImpactScore Int?
  logicalClarityScore  Int?
  overallScore      Int?
  strengths         Json?
  issues            Json?
  suggestions       Json?
  emotionalArcAnalysis Json?
  conclusion        String?
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  draft Draft @relation(fields: [draftId], references: [id], onDelete: Cascade)
  topic  Topic @relation(fields: [topicId], references: [id], onDelete: Cascade)

  @@index([topicId])
}

// ─── Humanization ─────────────────────────────────────

model Humanization {
  id              String   @id @default(cuid())
  draftId         String   @unique
  topicId         String
  aiStyleScore    Int?
  humanizedScore   Int?
  adopted         Boolean  @default(false)
  changes         Json?
  issues          Json?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  draft Draft @relation(fields: [draftId], references: [id], onDelete: Cascade)
  topic  Topic @relation(fields: [topicId], references: [id], onDelete: Cascade)

  @@index([topicId])
}

// ─── Strategy Evaluation ──────────────────────────────

model StrategyEvaluation {
  id                  String   @id @default(cuid())
  draftId             String   @unique
  topicId             String
  platform            String
  overallScore        Int?
  grade               String?
  scores             Json?
  platformFit         Int?
  strategyConsistency Int?
  strengths           Json?
  weaknesses           Json?
  criticalIssues      Json?
  improvementPriorities Json?
  shareAnalysis       Json?
  aiStyleRisk         Int?
  authenticityScore   Int?
  evidenceQuality     Int?
  confidence          Float?
  verdict             String?
  createdAt           DateTime @default(now())
  updatedAt           DateTime @updatedAt

  draft Draft @relation(fields: [draftId], references: [id], onDelete: Cascade)
  topic  Topic @relation(fields: [topicId], references: [id], onDelete: Cascade)

  @@index([topicId])
}

// ─── Content Adaptation ───────────────────────────────

model ContentAdaptation {
  id              String   @id @default(cuid())
  topicId         String
  referencePlatform  String?
  referenceUrl      String?
  referenceTitle    String?
  referenceAuthor   String?
  referenceContent  String?
  referenceMetrics  Json?
  userIdea         String?
  personaId        String?
  referenceAnalysis Json?
  adaptedAngles    Json?
  strategySuggestion Json?
  selectedAngleId  String?
  status           String   @default("PENDING")
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  topic Topic @relation(fields: [topicId], references: [id], onDelete: Cascade)

  @@index([topicId])
}

// ─── Agent Runtime ──────────────────────────────────────

model AgentRun {
  id          String   @id @default(cuid())
  topicId     String?
  skillId     String?
  input       Json?
  output      Json?
  model       String?
  tokens      Int?
  latency     Int?
  status      String   @default("pending")
  error       String?
  startedAt   DateTime?
  completedAt DateTime?
  createdAt   DateTime @default(now())

  @@index([topicId])
  @@index([skillId])
}

// ─── Skills Registry ───────────────────────────────────

model Skill {
  id          String   @id @default(cuid())
  name        String   @unique
  version     String   @default("1.0.0")
  description String?
  isActive    Boolean  @default(true)
  config      Json?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

// ─── Inspiration ──────────────────────────────────────

model Inspiration {
  id        String   @id @default(cuid())
  userId    String
  title     String
  content   String
  source    String   @default("manual")
  sourceUrl String?
  tags      Json?
  category  String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([category])
}

// ─── User Content Archive ─────────────────────────────

model UserContentArchive {
  id                  String   @id @default(cuid())
  userId              String
  topic               String
  platform            String?
  finalTitle          String
  finalContent        String
  finalHook           String?
  refineChanges       Json?
  refineData          Json?
  humanizationData    Json?
  humanizationAdopted Boolean?
  resolvedIssues      Json?
  unresolvedIssues    Json?
  preservedElements   Json?
  draftVersion        Int?
  refineVersion       Int?
  selectedAngleTitle  String?
  strategyTone        String?
  wordCount           Int?
  createdAt           DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([platform])
}

// ─── Memory Record ────────────────────────────────────

model MemoryRecord {
  id             String   @id
  kind           String
  type           String
  payload        Json
  scope          String

  ownerId        String
  projectId      String?
  topicId        String?

  source         String
  sourceType     String
  derivedFrom    Json?

  confidence     Float
  importance     Float

  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  lastAccessedAt DateTime?
  accessCount    Int      @default(0)

  expiresAt      DateTime?
  version        Int      @default(1)
  status         String   @default("active")

  @@index([ownerId])
  @@index([projectId])
  @@index([topicId])
  @@index([scope])
  @@index([status])
  @@index([kind])
  @@index([ownerId, scope])
  @@index([ownerId, projectId])
  @@index([ownerId, topicId])
}

// ─── Outcome Alert ────────────────────────────────────
// P0.6.5.3 — Outcome Alert Store
// 領域模型: src/memory/outcome-alert.ts (OutcomeAlert)
// Note: Alert inherits scope (ownerId, projectId, topicId) from Outcome.
//       Fingerprint provides deterministic dedup (ruleId:outcomeId).

model OutcomeAlert {
  id                String   @id
  ruleId            String
  outcomeId         String
  ownerId           String
  projectId         String?
  topicId           String?
  severity          String
  status            String   @default("open")
  title             String
  message           String
  matchedConditions Json?
  triggeredAt       DateTime
  acknowledgedAt    DateTime?
  resolvedAt        DateTime?
  suppressedAt      DateTime?
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt
  version           Int      @default(1)
  fingerprint       String   @unique

  @@index([ownerId])
  @@index([ownerId, projectId])
  @@index([ownerId, topicId])
  @@index([ownerId, status])
  @@index([ownerId, severity])
  @@index([ruleId])
  @@index([outcomeId])
}

// ─── User Writing Profile ─────────────────────────────

model UserWritingProfile {
  id                  String   @id @default(cuid())
  userId              String   @unique
  toneProfile         Json?
  personality         Json?
  languagePatterns    Json?
  preferredTopics     Json?
  preferredStructures Json?
  hookStyles          Json?
  emotionalTendencies Json?
  summary             String?
  version             Int      @default(1)
  lastDistillAt       DateTime?
  distillSampleCount  Int      @default(0)
  createdAt           DateTime @default(now())
  updatedAt           DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}
