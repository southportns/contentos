// Content OS — Prisma Schema
// Data Domains: Identity, Projects, Topics, Research, Content, Analysis, Insights, Angles, Strategy, Drafts, Evaluation, Agents, Skills, Runs

generator client {
  provider        = "prisma-client-js"
  output          = "../src/generated/prisma"
  previewFeatures = ["postgresqlExtensions"]
}

datasource db {
  provider   = "postgresql"
  extensions = [vector]
}

// ─── Identity ───────────────────────────────────────────

model User {
  id        String   @id @default(cuid())
  email     String   @unique
  name      String?
  avatar    String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  projects Project[]
}

// ─── Projects ───────────────────────────────────────────

model Project {
  id          String   @id @default(cuid())
  name        String
  description String?
  status      String   @default("active") // active | archived
  userId      String
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  user   User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  topics Topic[]
}

// ─── Topics ─────────────────────────────────────────────

model Topic {
  id          String   @id @default(cuid())
  projectId   String
  topic       String
  category    String?
  platform    String? // xiaohongshu | douyin | weibo | zhihu | wechat
  audience    String?
  contentType String? // emotional | opinion | story | knowledge
  goal        String?
  tone        String?
  constraints String?
  status      String   @default("DRAFT") // DRAFT | RESEARCHING | ANALYZING | ANGLE_SELECTION | STRATEGY | WRITING | EVALUATING | OPTIMIZING | READY | PUBLISHED | FEEDBACK
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  project          Project           @relation(fields: [projectId], references: [id], onDelete: Cascade)
  researchSessions ResearchSession[]
  contents         Content[]
  analyses         ContentAnalysis[]
  insights         AudienceInsight[]
  angles           Angle[]
  strategy         ContentStrategy?
  drafts           Draft[]
  evaluations      Evaluation[]

  @@index([projectId])
}

// ─── Research ────────────────────────────────────────────

model ResearchSession {
  id          String   @id @default(cuid())
  topicId     String
  status      String   @default("pending") // pending | running | completed | failed
  queries     Json?    // search queries array
  result      Json?    // research result summary
  startedAt   DateTime?
  completedAt DateTime?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  topic    Topic     @relation(fields: [topicId], references: [id], onDelete: Cascade)
  contents Content[]

  @@index([topicId])
}

// ─── Content ────────────────────────────────────────────

model Content {
  id                String   @id @default(cuid())
  researchSessionId String?
  topicId           String
  platform          String? // xiaohongshu | douyin | weibo | zhihu | wechat | web
  url               String?
  title             String?
  author            String?
  body              String?
  publishedAt       DateTime?
  likes             Int?
  commentsCount     Int?
  shares            Int?
  favorites         Int?
  views             Int?
  engagementRate    Float?
  keywords          String[] // array of keywords
  emotions          String[] // array of emotions
  contentStructure  Json? // content structure graph
  rawHtml           String?
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  researchSession ResearchSession? @relation(fields: [researchSessionId], references: [id], onDelete: SetNull)
  topic           Topic            @relation(fields: [topicId], references: [id], onDelete: Cascade)
  analysis        ContentAnalysis?
  comments        Comment[]

  @@index([topicId])
  @@index([platform])
}

model Comment {
  id        String   @id @default(cuid())
  contentId String
  author    String?
  text      String
  likes     Int?
  createdAt DateTime @default(now())

  content Content @relation(fields: [contentId], references: [id], onDelete: Cascade)

  @@index([contentId])
}

// ─── Analysis ────────────────────────────────────────────

model ContentAnalysis {
  id               String   @id @default(cuid())
  contentId        String   @unique
  topicId          String
  hookScore        Int?
  emotionScore     Int?
  relatabilityScore Int?
  noveltyScore     Int?
  structureScore   Int?
  shareabilityScore Int?
  conflictScore    Int?
  storyScore       Int?
  viralScore       Int?
  reasoning        String?
  contentStructure Json? // hook, problem, emotion, insight, story, conflict, resolution, cta
  emotionCurve     Json?  // emotion progression
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  content Content @relation(fields: [contentId], references: [id], onDelete: Cascade)
  topic   Topic   @relation(fields: [topicId], references: [id], onDelete: Cascade)

  @@index([topicId])
}

// ─── Insights ────────────────────────────────────────────

model AudienceInsight {
  id             String   @id @default(cuid())
  topicId        String
  painPoints     String[]
  emotions       String[]
  questions      String[]
  opinions       String[]
  controversies  String[]
  stories        String[]
  desires        String[]
  fears          String[]
  summary        String?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  topic Topic @relation(fields: [topicId], references: [id], onDelete: Cascade)

  @@index([topicId])
}

// ─── Angles ─────────────────────────────────────────────

model Angle {
  id                 String   @id @default(cuid())
  topicId            String
  title              String
  coreThesis         String
  targetAudience     String?
  emotion            String?
  noveltyScore       Int?
  relatabilityScore  Int?
  shareabilityScore  Int?
  risk               String?
  supportingEvidence String?
  status             String   @default("GENERATED") // GENERATED | WAITING_FOR_APPROVAL | APPROVED | REJECTED
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt

  topic Topic @relation(fields: [topicId], references: [id], onDelete: Cascade)

  @@index([topicId])
}

// ─── Strategy ───────────────────────────────────────────

model ContentStrategy {
  id               String   @id @default(cuid())
  topicId          String   @unique
  angleId          String?
  coreThesis       String
  targetEmotion    String?
  targetAudience   String?
  hookStrategy     String?
  contentStructure Json?
  storyStrategy    String?
  conflict         String?
  turningPoint     String?
  endingStrategy   String?
  ctaStrategy      String?
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  topic Topic @relation(fields: [topicId], references: [id], onDelete: Cascade)

  @@index([topicId])
}

// ─── Drafts ─────────────────────────────────────────────

model Draft {
  id        String   @id @default(cuid())
  topicId   String
  version   Int      @default(1)
  title     String?
  content   String
  outline   Json?
  status    String   @default("DRAFT") // DRAFT | HUMANIZED | FINAL
  wordCount Int?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  topic      Topic       @relation(fields: [topicId], references: [id], onDelete: Cascade)
  evaluation Evaluation?

  @@index([topicId])
}

// ─── Evaluation ─────────────────────────────────────────

model Evaluation {
  id                String   @id @default(cuid())
  draftId           String   @unique
  topicId           String
  hookScore         Int?
  emotionScore      Int?
  relatabilityScore Int?
  noveltyScore      Int?
  structureScore    Int?
  readabilityScore  Int?
  shareabilityScore Int?
  platformFitScore  Int?
  aiStyleScore      Int?
  overallScore      Int?
  strengths         String[]
  issues            String[]
  suggestions       Json? // array of { issue, suggestion, priority }
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  draft Draft @relation(fields: [draftId], references: [id], onDelete: Cascade)
  topic  Topic @relation(fields: [topicId], references: [id], onDelete: Cascade)

  @@index([topicId])
}

// ─── Agent Runtime ──────────────────────────────────────

model AgentRun {
  id          String   @id @default(cuid())
  topicId     String?
  skillId     String?
  input       Json?
  output      Json?
  model       String?
  tokens      Int?
  latency     Int? // in milliseconds
  status      String   @default("pending") // pending | running | completed | failed | timeout
  error       String?
  startedAt   DateTime?
  completedAt DateTime?
  createdAt   DateTime @default(now())

  @@index([topicId])
  @@index([skillId])
}

// ─── Skills Registry ───────────────────────────────────

model Skill {
  id          String   @id @default(cuid())
  name        String   @unique
  version     String   @default("1.0.0")
  description String?
  isActive    Boolean  @default(true)
  config      Json?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}
