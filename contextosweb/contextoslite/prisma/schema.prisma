// Content OS — Prisma Schema
// Data Domains: Identity, Projects, Topics, Research, Content, Analysis, Insights, Angles, Strategy, Drafts, Evaluation, Humanization, StrategyEvaluation, Agents, Skills, Runs

generator client {
  provider = "prisma-client-js"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "sqlite"
}

// ─── Identity ───────────────────────────────────────────

model User {
  id        String   @id @default(cuid())
  email     String   @unique
  name      String?
  avatar    String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  projects            Project[]
  inspirations        Inspiration[]
  contentArchives     UserContentArchive[]
  writingProfile      UserWritingProfile?
  personas            Persona[]
}

// ─── Projects ───────────────────────────────────────────

model Project {
  id          String   @id @default(cuid())
  name        String
  description String?
  status      String   @default("active") // active | archived
  userId      String
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  user   User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  topics Topic[]
}

// ─── Persona ───────────────────────────────────────────
// 用户自定义人设，影响内容策略和写作风格

model Persona {
  id          String   @id @default(cuid())
  userId      String
  name        String
  description String?
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  user   User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  topics Topic[]

  @@index([userId])
}

// ─── Topics ─────────────────────────────────────────────

model Topic {
  id          String   @id @default(cuid())
  projectId   String
  topic       String
  category    String?
  platform    String? // xiaohongshu | douyin | weibo | zhihu | wechat
  audience    String?
  contentType String? // emotional | opinion | story | knowledge
  goal        String?
  tone        String?
  constraints String?
  status      String   @default("DRAFT") // DRAFT | RESEARCHING | ANALYZING | ANGLE_SELECTION | STRATEGY | WRITING | EVALUATING | OPTIMIZING | READY | PUBLISHED | FEEDBACK
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  project              Project              @relation(fields: [projectId], references: [id], onDelete: Cascade)
  researchSessions     ResearchSession[]
  contents             Content[]
  analyses             ContentAnalysis[]
  insights             AudienceInsight[]
  angles               Angle[]
  strategy             ContentStrategy?
  drafts               Draft[]
  evaluations          Evaluation[]
  humanizations       Humanization[]
  strategyEvaluations  StrategyEvaluation[]
  persona              Persona?  @relation(fields: [personaId], references: [id], onDelete: SetNull)
  personaId            String?

  @@index([projectId])
  @@index([personaId])
}

// ─── Research ────────────────────────────────────────────

model ResearchSession {
  id          String   @id @default(cuid())
  topicId     String
  status      String   @default("pending") // pending | running | completed | failed
  queries     Json?    // search queries array
  result      Json?    // research result summary
  startedAt   DateTime?
  completedAt DateTime?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  topic    Topic     @relation(fields: [topicId], references: [id], onDelete: Cascade)
  contents Content[]

  @@index([topicId])
}

// ─── Content ────────────────────────────────────────────

model Content {
  id                String   @id @default(cuid())
  researchSessionId String?
  topicId           String
  platform          String? // xiaohongshu | douyin | weibo | zhihu | wechat | web
  url               String?
  title             String?
  author            String?
  body              String?
  publishedAt       DateTime?
  likes             Int?
  commentsCount     Int?
  shares            Int?
  favorites         Int?
  views             Int?
  engagementRate    Float?
  keywords          Json?    // array of keywords (stored as JSON for SQLite)
  emotions          Json?    // array of emotions (stored as JSON for SQLite)
  contentStructure  Json? // content structure graph
  rawHtml           String?
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  researchSession ResearchSession? @relation(fields: [researchSessionId], references: [id], onDelete: SetNull)
  topic           Topic            @relation(fields: [topicId], references: [id], onDelete: Cascade)
  analysis        ContentAnalysis?
  comments        Comment[]

  @@index([topicId])
  @@index([platform])
}

model Comment {
  id        String   @id @default(cuid())
  contentId String
  author    String?
  text      String
  likes     Int?
  createdAt DateTime @default(now())

  content Content @relation(fields: [contentId], references: [id], onDelete: Cascade)

  @@index([contentId])
}

// ─── Analysis ────────────────────────────────────────────

model ContentAnalysis {
  id               String   @id @default(cuid())
  contentId        String   @unique
  topicId          String
  hookScore        Int?
  emotionScore     Int?
  relatabilityScore Int?
  noveltyScore     Int?
  structureScore   Int?
  shareabilityScore Int?
  conflictScore    Int?
  storyScore       Int?
  viralScore       Int?
  controversyScore Int?
  utilityScore     Int?
  reasoning        String?
  contentStructure Json? // hook, problem, emotion, insight, story, conflict, resolution, cta
  emotionCurve     Json?  // emotion progression
  strengths       Json?    // array of strings (stored as JSON for SQLite)
  weaknesses       Json?    // array of strings (stored as JSON for SQLite)
  keyFactors       Json?    // array of strings (stored as JSON for SQLite)
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  content Content @relation(fields: [contentId], references: [id], onDelete: Cascade)
  topic   Topic   @relation(fields: [topicId], references: [id], onDelete: Cascade)

  @@index([topicId])
}

// ─── Insights ────────────────────────────────────────────

model AudienceInsight {
  id             String   @id @default(cuid())
  topicId        String
  painPoints     Json?    // array of strings (stored as JSON for SQLite)
  emotions       Json?    // array of strings (stored as JSON for SQLite)
  questions      Json?    // array of strings (stored as JSON for SQLite)
  opinions       Json?    // array of strings (stored as JSON for SQLite)
  controversies  Json?    // array of strings (stored as JSON for SQLite)
  stories        Json?    // array of strings (stored as JSON for SQLite)
  desires        Json?    // array of strings (stored as JSON for SQLite)
  fears          Json?    // array of strings (stored as JSON for SQLite)
  needs          Json?    // array of strings (stored as JSON for SQLite)
  behaviors      Json?    // array of strings (stored as JSON for SQLite)
  preferences    Json?    // array of strings (stored as JSON for SQLite)
  contentGaps   Json?    // array of strings (stored as JSON for SQLite)
  demographics   Json?    // { primaryAgeRange, primaryGender, secondaryAgeRange, secondaryGender }
  emotionDetails Json?    // [{ emotion, intensity, percentage }]
  summary        String?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  topic Topic @relation(fields: [topicId], references: [id], onDelete: Cascade)

  @@index([topicId])
}

// ─── Angles ─────────────────────────────────────────────

model Angle {
  id                 String   @id @default(cuid())
  topicId            String
  title              String
  coreThesis         String
  targetAudience     String?
  emotion            String?
  noveltyScore       Int?
  relatabilityScore  Int?
  shareabilityScore  Int?
  risk               String?
  supportingEvidence String?
  keyPoints          Json?    // array of strings (stored as JSON for SQLite)
  audienceAppeal     String?
  estimatedViralScore Int?
  status             String   @default("GENERATED") // GENERATED | WAITING_FOR_APPROVAL | APPROVED | REJECTED
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt

  topic Topic @relation(fields: [topicId], references: [id], onDelete: Cascade)

  @@index([topicId])
}

// ─── Strategy ───────────────────────────────────────────

model ContentStrategy {
  id               String   @id @default(cuid())
  topicId          String   @unique
  angleId          String?
  coreThesis       String
  targetEmotion    String?
  targetAudience   String?
  hookStrategy     String?
  contentStructure Json?
  storyStrategy    String?
  conflict         String?
  turningPoint     String?
  endingStrategy   String?
  ctaStrategy      String?
  keyArguments     Json?    // array of strings (stored as JSON for SQLite)
  suggestedReferences Json? // array of strings (stored as JSON for SQLite)
  tone             String?
  estimatedWordCount Int?
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  topic Topic @relation(fields: [topicId], references: [id], onDelete: Cascade)

  @@index([topicId])
}

// ─── Drafts ─────────────────────────────────────────────

model Draft {
  id        String   @id @default(cuid())
  topicId   String
  version   Int      @default(1)
  title     String?
  content   String
  outline   Json?
  status    String   @default("DRAFT") // DRAFT | HUMANIZED | FINAL
  wordCount Int?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  topic               Topic                @relation(fields: [topicId], references: [id], onDelete: Cascade)
  evaluation          Evaluation?
  humanization        Humanization?
  strategyEvaluation  StrategyEvaluation?

  @@index([topicId])
}

// ─── Evaluation ─────────────────────────────────────────

model Evaluation {
  id                String   @id @default(cuid())
  draftId           String   @unique
  topicId           String
  hookScore         Int?
  emotionScore      Int?
  relatabilityScore Int?
  noveltyScore      Int?
  structureScore    Int?
  readabilityScore   Int?
  shareabilityScore Int?
  platformFitScore   Int?
  aiStyleScore      Int?
  utilityScore       Int?
  emotionalImpactScore Int?
  logicalClarityScore  Int?
  overallScore      Int?
  strengths         Json?    // array of strings (stored as JSON for SQLite)
  issues            Json?    // array of strings (stored as JSON for SQLite)
  suggestions       Json? // array of { section, issue, suggestion, priority }
  emotionalArcAnalysis Json? // { achieved: boolean, analysis: string }
  conclusion        String?
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  draft Draft @relation(fields: [draftId], references: [id], onDelete: Cascade)
  topic  Topic @relation(fields: [topicId], references: [id], onDelete: Cascade)

  @@index([topicId])
}

// ─── Humanization ─────────────────────────────────────

model Humanization {
  id              String   @id @default(cuid())
  draftId         String   @unique
  topicId         String
  aiStyleScore    Int?
  humanizedScore   Int?
  changes         Json?    // [{ original, revised, reason, type }]
  issues          Json?    // [{ type, description, severity }]
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  draft Draft @relation(fields: [draftId], references: [id], onDelete: Cascade)
  topic  Topic @relation(fields: [topicId], references: [id], onDelete: Cascade)

  @@index([topicId])
}

// ─── Strategy Evaluation ──────────────────────────────

model StrategyEvaluation {
  id                  String   @id @default(cuid())
  draftId             String   @unique
  topicId             String
  platform            String
  overallScore        Int?
  grade               String?   // exceptional | strong | good | average | poor
  scores             Json?     // Record<string, number>
  platformFit         Int?
  strategyConsistency Int?
  strengths           Json?    // array of strings (stored as JSON for SQLite)
  weaknesses           Json?    // array of strings (stored as JSON for SQLite)
  criticalIssues      Json?    // array of strings (stored as JSON for SQLite)
  improvementPriorities Json?  // [{ priority, problem, reason, suggestion }]
  shareAnalysis       Json?    // { motivation, target, context }
  aiStyleRisk         Int?
  authenticityScore   Int?
  evidenceQuality     Int?
  confidence          Float?
  verdict             String?
  createdAt           DateTime @default(now())
  updatedAt           DateTime @updatedAt

  draft Draft @relation(fields: [draftId], references: [id], onDelete: Cascade)
  topic  Topic @relation(fields: [topicId], references: [id], onDelete: Cascade)

  @@index([topicId])
}

// ─── Agent Runtime ──────────────────────────────────────

model AgentRun {
  id          String   @id @default(cuid())
  topicId     String?
  skillId     String?
  input       Json?
  output      Json?
  model       String?
  tokens      Int?
  latency     Int? // in milliseconds
  status      String   @default("pending") // pending | running | completed | failed | timeout
  error       String?
  startedAt   DateTime?
  completedAt DateTime?
  createdAt   DateTime @default(now())

  @@index([topicId])
  @@index([skillId])
}

// ─── Skills Registry ───────────────────────────────────

model Skill {
  id          String   @id @default(cuid())
  name        String   @unique
  version     String   @default("1.0.0")
  description String?
  isActive    Boolean  @default(true)
  config      Json?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

// ─── Inspiration ──────────────────────────────────────
// 用户自行添加的灵感、思路、好内容记录

model Inspiration {
  id        String   @id @default(cuid())
  userId    String
  title     String
  content   String
  source    String   @default("manual") // manual | url | imported
  sourceUrl String?
  tags      Json?    // array of strings (stored as JSON for SQLite)
  category  String?  // idea | reference | angle | structure | hook | other
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([category])
}

// ─── User Content Archive ─────────────────────────────
// 记录用户每次用 Content OS 生成的最终稿及微调记录，用于风格蒸馏

model UserContentArchive {
  id                String   @id @default(cuid())
  userId            String
  topic             String
  platform          String?
  finalTitle        String
  finalContent      String
  finalHook         String?
  refineChanges     Json?    // 微调变更记录 [{ type, original, revised, reason }]
  selectedAngleTitle String?
  strategyTone      String?
  wordCount         Int?
  createdAt         DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([platform])
}

// ─── User Writing Profile ─────────────────────────────
// 蒸馏后的用户写作画像，供 Writing Skill 参照

model UserWritingProfile {
  id                  String   @id @default(cuid())
  userId              String   @unique
  toneProfile         Json?    // 语调特征 { formality, energy, humor, directness, ... }
  personality         Json?    // 性格标签 ["理性分析型", "情感共鸣型", ...] (stored as JSON for SQLite)
  languagePatterns    Json?    // 语言模式 { sentenceRhythm, vocabularyTend, catchphrases, ... }
  preferredTopics     Json?    // 偏好的主题方向 (stored as JSON for SQLite)
  preferredStructures Json?    // 偏好的内容结构 [{ structure, frequency }]
  hookStyles          Json?    // 偏好的钩子风格 ["悬念型", "冲突型", ...] (stored as JSON for SQLite)
  emotionalTendencies Json?    // 情绪倾向 { primary, secondary, intensity }
  summary             String?  // AI 生成的综合风格描述
  version             Int      @default(1)
  lastDistillAt       DateTime?
  distillSampleCount  Int      @default(0)
  createdAt           DateTime @default(now())
  updatedAt           DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}
