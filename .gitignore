# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# prisma generated
src/generated/

# electron build output
/electron-dist/
/dist-electron/
/dist-release/
/release/
/release-out/
/electron-build*.log

# ─── Local database (do not commit user data) ───────
dev.db
dev.db-journal
*.db
*.db-journal

# ─── Temporary test / debug files ────────────────────
null
test-config.ts
test-filtered.json
test-minimal.json
test-pg-connection.js
test-pg-regions.js
test-prisma.ts
test-regions.cjs
test-regions.ps1
test-search-full.json
test-topic-result.json
prisma-generate.log
find-region.js

# ─── OS / editor artifacts ────────────────────────────
.mignore
*.log
