{
  "name": "content-os",
  "version": "0.1.0",
  "private": true,
  "main": "dist-electron/main.js",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "electron:dev": "concurrently -k \"npm:dev\" \"wait-on http://localhost:3000 && cross-env NODE_ENV=development npx tsx electron/main.ts\"",
    "electron:compile": "tsup electron/main.ts electron/preload.ts --format cjs --platform node --target node18 --out-dir dist-electron --external electron --external better-sqlite3 --external @prisma/client --external @prisma/adapter-better-sqlite3 --external next --sourcemap --clean",
    "electron:rebuild": "npx tsx scripts/rebuild-native.ts",
    "prebuild": "npx tsx scripts/prebuild.ts",
    "electron:build": "npm run build && npm run prebuild && npm run electron:compile && npm run electron:rebuild && electron-builder --config electron-builder.yml",
    "electron:dist": "npm run build && npm run prebuild && npm run electron:compile && npm run electron:rebuild && electron-builder --config electron-builder.yml --win nsis"
  },
  "dependencies": {
    "@ai-sdk/anthropic": "^4.0.42",
    "@ai-sdk/google": "^4.0.51",
    "@ai-sdk/openai": "^4.0.47",
    "@base-ui/react": "^1.7.0",
    "@langchain/core": "^1.2.9",
    "@langchain/langgraph": "^1.4.12",
    "@prisma/adapter-better-sqlite3": "^7.10.0",
    "@prisma/client": "^7.9.1",
    "ai": "^7.0.79",
    "better-sqlite3": "^12.11.1",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "dotenv": "^17.4.2",
    "lucide-react": "^1.34.0",
    "next": "16.3.2",
    "next-themes": "^0.4.6",
    "prisma": "^7.9.1",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "react-resizable-panels": "^4.12.3",
    "shadcn": "^4.19.0",
    "sonner": "^2.0.8",
    "tailwind-merge": "^3.6.0",
    "tw-animate-css": "^1.4.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@electron/rebuild": "^4.1.0",
    "@tailwindcss/postcss": "^4",
    "@types/better-sqlite3": "^9.6.0",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "concurrently": "^9.1.0",
    "cross-env": "^7.0.3",
    "electron": "^33.4.11",
    "electron-builder": "^25.1.8",
    "eslint": "^9",
    "eslint-config-next": "16.3.2",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-prettier": "^5.5.6",
    "jsrepo": "^3.8.1",
    "ogl": "^1.0.11",
    "prettier": "^3.9.6",
    "prettier-plugin-tailwindcss": "^0.8.1",
    "tailwindcss": "^4",
    "tsup": "^8.5.1",
    "tsx": "^4.23.12",
    "typescript": "^5",
    "vitest": "^3.2.7",
    "wait-on": "^8.0.0"
  },
  "allowScripts": {
    "better-sqlite3@12.11.1": true,
    "better-sqlite3@13.0.3": true,
    "@prisma/engines@7.9.1": true,
    "electron@33.4.11": true
  }
}
