# ──────────────────────────────────────
# Content OS — Environment Variables
# ──────────────────────────────────────

# Database (SQLite — no external server needed)
DATABASE_URL="file:./dev.db"

# AI Providers (at least one required)
# 支持的厂商: OpenAI / Anthropic / Google / DeepSeek / 智谱GLM / 通义千问 / Kimi / 腾讯混元 / 小米MiMo / MiniMax / 字节豆包
# 只需填写你使用的那一个厂商的 Key 即可
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
GOOGLE_GENERATIVE_AI_API_KEY=
DEEPSEEK_API_KEY=
GLM_API_KEY=

# AI Provider Base URLs (optional, defaults shown)
# DEEPSEEK_BASE_URL=https://api.deepseek.com/v1
# GLM_BASE_URL=https://open.bigmodel.cn/api/paas/v4

# AI Config
# Available providers: openai, anthropic, google, deepseek, glm
AI_PROVIDER=deepseek
AI_MODEL=deepseek-chat

# App
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Default User (single-user mode)
DEFAULT_USER_ID=default

# ─── Douyin Ingest (口播文案提取) ───────────────────
# douyin-ingest CLI 可执行文件路径（默认在 PATH 中查找）
# 安装: pip install "douyin-ingest[agent] @ git+https://github.com/ltppp/douyin-ingest.git@v0.3.0"
# DOUYIN_INGEST_BIN=douyin-ingest
# douyin-ingest 数据目录（storage_state.json 所在目录）
# DOUYIN_INGEST_HOME=

# ─── Content Transcript Engine ──────────────────────
# ASR 模式: cloud (当前版本仅支持云端模式)
ASR_MODE=cloud

# ─── Local ASR (faster-whisper) ─────────────────────
# Whisper 模型大小: tiny / small / base / medium / large-v3
# medium (769M) 推荐中文场景, large-v3 (1.5B) 最高质量
# WHISPER_MODEL=medium
# 计算设备: cpu / cuda
# WHISPER_DEVICE=cpu
# beam search 大小 (1=greedy, 5=推荐质量)
# WHISPER_BEAM_SIZE=5
# 量化类型 (int8 for CPU, int8_float16 for GPU)
# WHISPER_COMPUTE_TYPE=
# douyin-ingest 缓存时间（秒）
# INGEST_CACHE_TTL=1800

# ─── Cloud ASR — 单选模式 ────────────────────────────
# 选择云端 ASR 服务商: alibaba / xiaomi (默认 alibaba)
# 只能选择一个服务商，切换后需配置对应的 API Key 和模型
# ASR_CLOUD_PROVIDER=alibaba

# ─── Cloud ASR — Alibaba (阿里云百炼) ────────────────
# 当 ASR_CLOUD_PROVIDER=alibaba 时生效
# 获取 API Key: https://bailian.console.aliyun.com/ -> API Key 管理
# ALIBABA_ASR_API_KEY=
# ASR 模型名称: fun-asr / qwen3-asr-flash
# ALIBABA_ASR_MODEL=fun-asr
# API 地址 (OpenAI-compatible)
# ALIBABA_ASR_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1

# ─── Cloud ASR — Xiaomi MiMo ──────────────────────────
# 当 ASR_CLOUD_PROVIDER=xiaomi 时生效
# 获取 API Key: https://platform.xiaomimimo.com/ -> 控制台 -> API Keys
# XIAOMI_ASR_API_KEY=
# ASR 模型名称: mimo-v2.5-asr (唯一可用)
# XIAOMI_ASR_MODEL=mimo-v2.5-asr
# API 地址 (OpenAI-compatible)
# XIAOMI_ASR_BASE_URL=https://api.xiaomimimo.com/v1

# ─── Semantic Embedding (P0.3.2-1) ────────────────────
# Embedding Provider 选择: mock (默认) / aliyun
# 开发环境默认使用 mock，无需 API Key
# 生产环境设置 EMBEDDING_PROVIDER=aliyun 启用云端 Embedding
# EMBEDDING_PROVIDER=mock

# ─── Cloud Embedding — Alibaba DashScope ──────────────
# 当 EMBEDDING_PROVIDER=aliyun 时生效
# 获取 API Key: https://bailian.console.aliyun.com/ -> API Key 管理
# DASHSCOPE_API_KEY=
# Embedding 模型: text-embedding-v4 (1024维)
# EMBEDDING_MODEL=text-embedding-v4
# EMBEDDING_DIMENSIONS=1024
# API 地址 (默认 DashScope 官方)
# EMBEDDING_BASE_URL=https://dashscope.aliyuncs.com
# 请求超时 (毫秒, 默认 30000)
# EMBEDDING_TIMEOUT_MS=30000
